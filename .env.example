# Copy to apps/api/.env (never commit .env). All values are environment-specific.
NODE_ENV=development
PORT=3100
HOST=127.0.0.1
# Public origin the browser uses (CSRF Origin check). Example: https://molding.example.local
PUBLIC_ORIGIN=http://localhost:5173
TRUST_PROXY=loopback
LOG_LEVEL=info

# Session cookie. Secure MUST stay true in production (FINAL §8). Setting false requires an approved exception.
COOKIE_SECURE=true
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_HOURS=12

# Application database (separate DB + non-superuser role inside the vendor PG 9.5 instance)
APP_DB_HOST=127.0.0.1
APP_DB_PORT=5432
APP_DB_NAME=molding_dashboard
APP_DB_USER=mpd_app
APP_DB_PASSWORD=
APP_DB_SSL=false
APP_DB_POOL_MAX=5
# Used only by db:migrate (owner of the app DB). Runtime never uses it.
MIGRATE_DB_USER=mpd_owner
MIGRATE_DB_PASSWORD=

# ConMas (read-only, SELECT-only account)
CONMAS_DB_HOST=127.0.0.1
CONMAS_DB_PORT=5432
CONMAS_DB_NAME=
CONMAS_DB_USER=
CONMAS_DB_PASSWORD=
CONMAS_DB_SSL=false
CONMAS_VIEW=view_report_27537
CONMAS_POOL_MAX=2
CONMAS_STATEMENT_TIMEOUT_MS=5000
CONMAS_CACHE_TTL_SECONDS=60
CONMAS_SOURCE_TIMEZONE_OFFSET=+07:00
# System columns are not in the view yet (owner: Monday). Empty = record selection impossible = data shown as unavailable (Q-019/Q-020).
CONMAS_COL_RECORD_ID=
CONMAS_COL_REV_NO=
CONMAS_COL_DELETED=
CONMAS_COL_UPDATED_AT=
